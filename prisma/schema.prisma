generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id              String   @id @db.Uuid
  formType        String   @map("form_type")
  status          String
  student         Json
  payload         Json
  attachment      Json?
  adminComment    String?  @map("admin_comment")
  internalNotes   String?  @map("internal_notes")
  assignedTo      Json?    @map("assigned_to")
  routingFlags    Json     @default("[]") @map("routing_flags")
  reviewerDecision String? @map("reviewer_decision")
  reviewerComment String?  @map("reviewer_comment")
  registryDecision String? @map("registry_decision")
  registryComment String?  @map("registry_comment")
  workflowHistory Json     @default("[]") @map("workflow_history")
  auditTrail      Json     @default("[]") @map("audit_trail")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")

  @@index([status])
  @@index([formType])
  @@map("submissions")
}

model ReferenceRecord {
  id        String   @id @db.Uuid
  kind      String
  data      Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@index([kind])
  @@map("reference_records")
}

model StudentNotification {
  id           String    @id @db.Uuid
  studentId    String    @map("student_id")
  submissionId String    @map("submission_id") @db.Uuid
  type         String
  title        String
  message      String
  readAt       DateTime? @map("read_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([studentId])
  @@index([submissionId])
  @@index([readAt])
  @@index([createdAt])
  @@map("student_notifications")
}
