NODE_ENV=production
APP_VERSION=0.1.0
GIT_COMMIT=<deployed-git-commit>
ALLOW_MOCK_SSO=false
SAML_ENABLED=true
SAML_PUBLIC_BASE_URL=https://eforms.costaatt.edu.tt
SAML_SP_ENTITY_ID=https://eforms.costaatt.edu.tt/api/saml/metadata
SAML_ACS_URL=https://eforms.costaatt.edu.tt/api/saml/acs
SAML_LOGOUT_URL=https://eforms.costaatt.edu.tt/api/saml/logout
SAML_IDP_METADATA_URL=https://sso.quicklaunch.io/admin/open/api/metadata?tenantDomain=costaatt.edu.tt
# Populate the following protected service-environment values from the retrieved QuickLaunch metadata.
SAML_IDP_ENTITY_ID=<quicklaunch-idp-entity-id>
SAML_IDP_SSO_URL=<quicklaunch-sso-endpoint>
SAML_IDP_SSO_BINDING=<quicklaunch-sso-binding>
SAML_IDP_LOGOUT_URL=<quicklaunch-slo-endpoint-if-advertised>
SAML_IDP_LOGOUT_BINDING=<quicklaunch-slo-binding-if-advertised>
SAML_IDP_CERT=<quicklaunch-signing-certificate-in-protected-environment>
SAML_NAMEID_FORMAT=urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress
SAML_REQUIRE_SIGNED_ASSERTIONS=true
SAML_SIGN_AUTHN_REQUESTS=false
SAML_ACCEPTED_CLOCK_SKEW_MS=0
SAML_MAX_ASSERTION_AGE_MS=300000
SAML_REQUEST_TTL_MS=300000
SAML_ROLE_GROUP_MAP=<costaatt-ad-group-role-json-if-approved>
SAML_TRUSTED_APPLICATION_ROLES=false
SAML_DEFAULT_REDIRECT=/forms

# Keep all secrets, database credentials, SMTP credentials, and optional IdP certificate values in the protected service environment.
SSO_SHARED_SECRET=<required-secret>
QUICKLAUNCH_JWT_SECRET=<not-used-in-SAML-mode-but-keep-configured-if-required-by-other-trusted-path>
TRUSTED_SSO_HEADER_NAME=x-portal-sso-token
TRUSTED_SSO_HEADER_MODE=signed-token
SLA_ESCALATION_SECRET=<required-secret>
DATABASE_URL=<postgres-connection-string>
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_FROM=registry@costaatt.edu.tt
REGISTRY_NOTIFICATION_EMAIL=registrar@costaatt.edu.tt
PORTAL_BASE_URL=https://eforms.costaatt.edu.tt
UPLOAD_MAX_MB=8
REFERENCE_BULK_IMPORT_ENABLED=false
REFERENCE_IMPORT_MAX_MB=8
REFERENCE_IMPORT_MAX_ROWS=10000
REFERENCE_IMPORT_ROW_RETENTION_DAYS=180
REFERENCE_IMPORT_SUMMARY_RETENTION_DAYS=730

# HTTPS reverse proxy values. The private key remains outside the repository.
HTTPS_PROXY_HOST=0.0.0.0
HTTPS_PROXY_PORT=443
HTTPS_PROXY_HTTP_PORT=80
HTTPS_PROXY_TARGET_HOST=127.0.0.1
HTTPS_PROXY_TARGET_PORT=5001
SSL_CERT_PATH=C:\Student E-Forms\SSL Private Key\eforms.costaatt.edu.tt\831f8f7a1833747d.pem
SSL_KEY_PATH=C:\Student E-Forms\SSL Private Key\eforms.costaatt.edu.tt.key
SSL_CA_PATH=C:\Student E-Forms\SSL Private Key\eforms.costaatt.edu.tt\gd_bundle_dv-r1-g2.crt.pem
